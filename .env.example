# Required: the admin's password. The admin is the one account that can add other users (in the app, under Users).
# Changing this signs the admin out of every device.
ACCESS_PASSWORD=change-me

# Optional: the admin's username (default: admin). Lowercase letters, numbers, dot, dash or underscore.
# ADMIN_USERNAME=admin

# Recommended: contact for the push service (mailto: or https:// URL).
# On Railway this defaults to your public domain if not set.
VAPID_SUBJECT=mailto:you@example.com

# Where state is stored. On Railway, attach a Volume and this defaults
# to the volume mount path automatically.
DATA_DIR=./data

# Optional overrides
# PORT=3000
# SESSION_SECRET=
# SCAN_START_DELAY_SECONDS=10

# Scraper behaviour
# SCRAPER_USER_AGENT=          # identify the scraper (default: RentalWatch/1.0 ...). Don't claim to be Chrome:
#                              # Cloudflare (Daft, Rent.ie) answers a fake browser with 403 "Security Check"
# SCRAPE_DELAY_MS=1200         # minimum gap between requests to the same host
# GEOCODER_USER_AGENT=         # sent to OpenStreetMap Nominatim and Overpass (map view; default includes VAPID_SUBJECT)
# GEOCODE_DELAY_MS=1100
# ALLOW_PRIVATE_URLS=1         # local testing only: allow http://127.0.0.1 source URLs

# Route blocked sources through a proxy or a laptop agent (see README "When a site blocks cloud hosts")
# SCRAPER_PROXY_URL=http://user:password@proxy.example.com:8080   # a paid residential proxy; wins over the agent
# SCRAPER_PROXY_SOURCES=daft,rent
# AGENT_TOKEN=                 # lets a laptop agent fetch those sources; 32+ random characters

# Laptop agent (npm run agent), in .env on the home computer
# AGENT_SERVER_URL=https://your-app.up.railway.app
# AGENT_TOKEN=                 # the same token as on the server
# AGENT_ALLOW=daft.ie,rent.ie
# AGENT_LOG=agent.log          # also write the log to this file
