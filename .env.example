# Required: password you type once on each device to open the app
ACCESS_PASSWORD=change-me

# Recommended: contact for the push service (mailto: or https:// URL).
# On Railway this defaults to your public domain if not set.
VAPID_SUBJECT=mailto:you@example.com

# Where state is stored. On Railway, attach a Volume and this defaults
# to the volume mount path automatically.
DATA_DIR=./data

# Optional overrides
# PORT=3000
# SESSION_SECRET=
# DAFT_API_URL=https://gateway.daft.ie/api/v2/ads/listings
# DAFT_USER_AGENT=
# SCAN_START_DELAY_SECONDS=10
