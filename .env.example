# Required: password you type once on each device to open the app
ACCESS_PASSWORD=change-me

# Recommended: contact for the push service (mailto: or https:// URL).
# On Railway this defaults to your public domain if not set.
VAPID_SUBJECT=mailto:you@example.com

# Where state is stored. On Railway, attach a Volume and this defaults
# to the volume mount path automatically.
DATA_DIR=./data

# Optional overrides
# PORT=3000
# SESSION_SECRET=
# SCAN_START_DELAY_SECONDS=10

# Scraper behaviour
# SCRAPER_USER_AGENT=          # identify the scraper (default: RentalWatch/1.0 ...). Don't claim to be Chrome:
#                              # Cloudflare (Daft, Rent.ie) answers a fake browser with 403 "Security Check"
# SCRAPE_DELAY_MS=1200         # minimum gap between requests to the same host
# GEOCODER_USER_AGENT=         # sent to OpenStreetMap Nominatim (default includes VAPID_SUBJECT)
# GEOCODE_DELAY_MS=1100
# ALLOW_PRIVATE_URLS=1         # local testing only: allow http://127.0.0.1 source URLs

# Route blocked sources through an HTTP(S) proxy (see README "When a site blocks cloud hosts")
# SCRAPER_PROXY_URL=http://relay:secret@relay.railway.internal:3128
# SCRAPER_PROXY_SOURCES=daft,rent

# Run this image as the egress relay instead of the app
# PROXY_MODE=1
# PROXY_PASSWORD=
# PROXY_USER=relay
# PROXY_ALLOW=daft.ie,rent.ie
# PROXY_SELFTEST=0
